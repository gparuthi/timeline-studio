{
  // Short links for Timeline Studio (see src/index.js). One KV namespace
  // maps a short id to the same compressed payload a long share link carries
  // in its fragment; GET /<id> serves the viewer with that payload inlined.
  "name": "timeline-links",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Served only on the custom domain. workers.dev stays off so there is
  // exactly one public hostname to reason about.
  "workers_dev": false,
  "routes": [{ "pattern": "tl.gaup.uk", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "LINKS", "id": "8813242d0bbf41a89fbe4ab0da1170ca" }],
  // The studio itself (index.html, view.html, the renderer, icons, vendor)
  // is served from the same Worker as static assets, so one deploy ships
  // the app and its API together on one origin. A request that matches a
  // file is answered from the assets; everything else (short ids, names,
  // /command, /resolve) reaches the code; "/" is answered by the code with
  // index.html, and files are served under their exact names (no .html
  // redirects). ../.assetsignore keeps the worker source and repo files
  // out of the upload.
  "assets": { "directory": "../", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none" },
  // POST /command edits a timeline from a plain-English instruction with
  // Workers AI (10k neurons a day free; one command costs ~25). The rate
  // limit keeps a stranger from burning that allowance: 20 commands a
  // minute per client address.
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [{ "name": "COMMANDS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    // Where the studio lives (this Worker's own assets); the viewer page
    // loads the renderer from here and the Edit hand-off points back at it.
    "STUDIO_URL": "https://tl.gaup.uk/"
  }
}
